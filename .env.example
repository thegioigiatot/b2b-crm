# ---------------------------------------------------------------------------
# Database — PostgreSQL (Neon / Supabase / local). See SETUP.md.
#   DATABASE_URL : pooled connection string (used by the app at runtime)
#   DIRECT_URL   : direct connection string (used by `prisma migrate`)
# For a local Homebrew Postgres both can be the same value.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Emails that get the ADMIN role on their first login (comma-separated).
ADMIN_EMAILS="you@company.com"

# ---------------------------------------------------------------------------
# Firebase Authentication — see SETUP.md for where to copy each value from.
# Leave every value blank for local development: the app then shows a
# "demo login" that signs you in as any seeded user (never enabled when
# FIREBASE_PROJECT_ID is set or in production).
# ---------------------------------------------------------------------------
# Web app config (Project settings > General > Your apps > SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the literal \n sequences from the JSON; they are converted at runtime.
FIREBASE_PRIVATE_KEY=""
